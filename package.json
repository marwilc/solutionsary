{
    "name": "solutionsary",
    "version": "2.0.0",
    "private": true,
    "type": "module",
    "description": "Landing page for Solutionsary, industrial supplies and maintenance services",
    "scripts": {
        "dev": "astro dev",
        "start": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "package:cpanel": "npm run build && rm -f solutionsary-cpanel.zip && (cd dist && zip -r -X ../solutionsary-cpanel.zip . -x '*.DS_Store') && ls -lh solutionsary-cpanel.zip",
        "astro": "astro",
        "check": "astro check",
        "format": "prettier --write \"src/**/*.{astro,ts,js,css,json}\"",
        "format:check": "prettier --check \"src/**/*.{astro,ts,js,css,json}\""
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.3",
        "@fontsource-variable/archivo": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@iconify-json/lucide": "^1.2.122",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.2.0",
        "astro-icon": "^1.1.5",
        "sharp": "^0.35.3",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^6.0.3"
    }
}
